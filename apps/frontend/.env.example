# --- Order storage (required for checkout / orders) ---
# MySQL connection string used by the server to create and store orders.
# Example: mysql://user:password@localhost:3306/irctcrdp
MYSQL_URL=

# --- Razorpay (required for checkout / payments) ---
# Test mode keys work out of the box for sandbox payments.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# --- Razorpay webhook (required to settle orders server-to-server) ---
# Must match the webhook secret configured in the Razorpay dashboard.
PAYMENT_WEBHOOK_SECRET=