# Backend API (apps/backend/.env) — NEVER copy this file into the frontend build.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000

# Private database — never exposed to the frontend
MYSQL_URL=mysql://user:password@localhost:3306/irctcrdp

# Auth
SESSION_SECRET=generate-with: openssl rand -hex 32
SESSION_TTL_SECONDS=2592000
COOKIE_DOMAIN=.irctcrdp.com

# Service-to-service auth between backend and provisioner
INTERNAL_API_SECRET=generate-with: openssl rand -hex 32

# Razorpay (test mode first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Provisioner
PROVISIONER_URL=http://127.0.0.1:4001

# CORS — lock to approved frontend origins
CORS_ORIGINS=https://irctcrdp.com,https://www.irctcrdp.com

# Emails in this list become admins on registration
ADMIN_EMAILS=

TRUST_PROXY=true
DB_POOL_SIZE=10