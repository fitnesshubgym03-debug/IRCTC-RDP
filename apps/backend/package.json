{
  "name": "@irctcrdp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/server.js",
    "migrate": "node --env-file=.env dist/src/database/migrate.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@irctcrdp/contracts": "workspace:*",
    "@irctcrdp/validation": "workspace:*",
    "fastify": "^5.12.0",
    "mysql2": "^3.23.3",
    "pino": "^10.3.1",
    "razorpay": "^2.9.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
