{
  "name": "irctcrdp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @irctcrdp/frontend build",
    "build:backend": "pnpm --filter @irctcrdp/backend build",
    "build:provisioner": "pnpm --filter @irctcrdp/provisioner build",
    "dev:backend": "pnpm --filter @irctcrdp/backend dev",
    "dev:provisioner": "pnpm --filter @irctcrdp/provisioner dev",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @irctcrdp/backend migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}